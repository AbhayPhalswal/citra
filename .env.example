# Every environment variable Citra reads, with its default.
#
# Citra reads plain environment variables - it does not load this file.
# On Windows set them once with `setx NAME "value"` and open a new
# terminal; or copy this to .env and source it from your shell if you
# prefer. Nothing here is required: with none of them set, Citra runs
# on loopback with LM Studio as the Smart Path and JSON logs.

# --- the model behind the Smart Path ------------------------------------
# A free Google AI Studio key. When set, non-hardware requests go to
# Gemini (~1.3s measured) instead of a local LM Studio model (LM Studio
# must then be running with a model loaded on its Server tab).
GEMINI_API_KEY=

# --- the dashboard / phone API server (citra_ui_server.py) ---------------
# Interface to bind. Anything other than loopback REFUSES to start unless
# CITRA_ALLOW_REMOTE=1 is also set, because the dashboard and WebSocket
# carry no authentication - only /api/* does. Use a private tailnet
# address if you set this at all; never a public IP.
CITRA_BIND_HOST=127.0.0.1
CITRA_ALLOW_REMOTE=

# --- the PC shell tool ---------------------------------------------------
# run_command lets the model execute shell commands on this machine
# (with a deny-list for the irreversible ones - see SECURITY.md). Set to
# "off" to remove the tool entirely; the right choice for a household
# install where nobody will ever ask for a shell.
CITRA_RUN_COMMAND=

# --- logging (citra_logging.py) ------------------------------------------
# json  = one JSON object per line (default; greppable, parseable)
# text  = 2026-09-13 13:05:07 [INFO] module: message, for a terminal you
#         are watching live
CITRA_LOG_FORMAT=json
CITRA_LOG_LEVEL=INFO

# --- speech model startup ------------------------------------------------
# Skips 36 network round-trips to huggingface.co on every launch. Citra
# sets this to 1 by itself once the models are cached; set it explicitly
# only to force it (a cache MISS then fails instead of downloading).
HF_HUB_OFFLINE=
